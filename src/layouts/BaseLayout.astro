---
import siteConfig from "@config";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import GlobalTooltip from "../components/GlobalTooltip.astro";
import BackToTop from "../components/BackToTop.astro";
import PageTransition from "../components/PageTransition.astro";
import LoadingBar from "../components/LoadingBar.astro";
import CustomCursor from "../components/CustomCursor.astro";

interface Props {
  pageTitle: string;
  description?: string;
  readingProgress?: boolean;
  readingLayout?: boolean;
  centeredHeading?: boolean;
}

const {
  pageTitle,
  description,
  readingProgress = false,
  readingLayout = false,
  centeredHeading = false,
} = Astro.props;
const metaDescription = description ?? siteConfig.description;
const lang = siteConfig.lang ?? "en";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link
      rel="preload"
      href="/fonts/Outfit-Latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={metaDescription} />
    <title>{pageTitle} - {siteConfig.title}</title>
    <script is:inline>
      (() => {
        const resolveIsDark = () => {
          let theme = null;
          try {
            theme = localStorage.getItem("theme");
          } catch {}
          const prefersDark = window.matchMedia(
            "(prefers-color-scheme: dark)",
          ).matches;
          return theme === "dark" || (theme !== "light" && prefersDark);
        };

        document.documentElement.classList.toggle("dark", resolveIsDark());
        document.addEventListener("astro:before-swap", (event) => {
          event.newDocument.documentElement.classList.toggle(
            "dark",
            resolveIsDark(),
          );
        });
      })();
    </script>
    <PageTransition />
    <LoadingBar />
  </head>
  <body>
    <Header />
    <main
      class:list={[
        "site-container page-content",
        { "reading-layout": readingLayout },
      ]}
      data-page-transition
      data-reading-progress={readingProgress ? "" : undefined}
    >
      <header class:list={["page-heading", { "text-center": centeredHeading }]}>
        {
          Astro.slots.has("page-header-prefix") && (
            <slot name="page-header-prefix" />
          )
        }
        <h1 class="my-0">{pageTitle}</h1>
        {
          description && (
            <p class="mt-3 text-base leading-relaxed text-gray-600 dark:text-gray-400">
              {description}
            </p>
          )
        }
        {
          Astro.slots.has("page-header-details") && (
            <div class={description ? "mt-4" : "mt-3"}>
              <slot name="page-header-details" />
            </div>
          )
        }
      </header>
      <slot />
    </main>
    <BackToTop />
    <Footer />
    <GlobalTooltip />
    <CustomCursor />
  </body>
</html>
