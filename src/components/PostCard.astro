---
import type { CollectionEntry } from "astro:content";
import { getTagHref } from "../utils/tags";
import { formatDate, getPostHref } from "../utils/content";

interface Props {
  post: CollectionEntry<"blog">;
  centered?: boolean;
}
const { post, centered = false } = Astro.props;
const titleId = `post-${encodeURIComponent(post.id)}`;
---

<article class="post-hit min-w-0" data-post-hit>
  <a
    class="post-entry"
    href={getPostHref(post.id)}
    aria-labelledby={titleId}
    data-cursor="article"></a>
  <div
    class:list={["post-surface", { "text-center": centered }]}
    data-post-surface
  >
    <h2 id={titleId} class="post-title m-0 text-2xl leading-snug font-bold">
      {post.data.title}
    </h2>
    {
      post.data.description && (
        <p
          class:list={[
            "mt-2 line-clamp-2 max-w-[45rem] text-sm leading-relaxed text-gray-600 dark:text-gray-400",
            { "mx-auto": centered },
          ]}
        >
          {post.data.description}
        </p>
      )
    }
    <div
      class:list={[
        "mt-3 flex flex-wrap items-baseline gap-x-5 gap-y-2 text-sm",
        { "justify-center": centered },
      ]}
    >
      <time
        datetime={post.data.pubDate.toISOString().slice(0, 10)}
        class="text-gray-600 dark:text-gray-400"
        >{formatDate(post.data.pubDate)}</time
      >
      {
        post.data.tags.length > 0 && (
          <ul
            class:list={[
              "flex flex-wrap gap-x-4 gap-y-2",
              { "justify-center": centered },
            ]}
            aria-label="Article tags"
          >
            {post.data.tags.map((tag: string) => (
              <li>
                <a href={getTagHref(tag)} class="post-tag" data-cursor="tag">
                  {tag}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</article>
