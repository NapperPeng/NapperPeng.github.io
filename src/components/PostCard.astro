---
import type { CollectionEntry } from "astro:content";
import { getTagHref } from "../utils/tags";
import { formatDate, getPostHref } from "../utils/content";

interface Props {
  post: CollectionEntry<"blog">;
}
const { post } = Astro.props;
---

<article class="min-w-0">
  <h2 class="m-0 text-2xl leading-snug font-bold">
    <a
      href={getPostHref(post.id)}
      class="text-gray-800 transition-colors hover:text-blue-700 dark:text-gray-100 dark:hover:text-blue-400"
      >{post.data.title}</a
    >
  </h2>
  {
    post.data.description && (
      <p class="mt-2 line-clamp-2 max-w-[45rem] text-sm leading-relaxed text-gray-600 dark:text-gray-400">
        {post.data.description}
      </p>
    )
  }
  <div class="mt-3 flex flex-wrap items-baseline gap-x-5 gap-y-2 text-sm">
    <time
      datetime={post.data.pubDate.toISOString().slice(0, 10)}
      class="text-gray-600 dark:text-gray-400"
      >{formatDate(post.data.pubDate)}</time
    >
    {
      post.data.tags.length > 0 && (
        <ul class="flex flex-wrap gap-x-4 gap-y-2" aria-label="Article tags">
          {post.data.tags.map((tag: string) => (
            <li>
              <a href={getTagHref(tag)} class="text-link">
                {tag}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>
