---
import { Icon } from "astro-icon/components";
import type { CollectionEntry } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import siteConfig from "@config";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { getBlogPosts } from "../../utils/content";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getBlogPosts();

  return paginate(posts, {
    pageSize: siteConfig.postsPerPage ?? 6,
  });
}) satisfies GetStaticPaths;

type Props = {
  page: Page<CollectionEntry<"blog">>;
};

const { page } = Astro.props;
const pageTitle =
  page.currentPage === 1 ? "Blog" : `Blog - Page ${page.currentPage}`;
const pageLinks = Array.from(
  { length: page.lastPage },
  (_, index) => index + 1,
);
---

<BaseLayout
  centeredHeading
  pageTitle={pageTitle}
  description="Browse all articles, notes, and guides."
>
  <section class="mb-10 flex flex-wrap justify-center gap-x-8 gap-y-3">
    <a
      href="/blog/tags"
      data-cursor="link"
      class="plain-link group inline-flex items-center gap-2"
    >
      <div class="shrink-0">
        <Icon name="lucide:tag" class="h-4 w-4" />
      </div>
      <div>
        <h3 class="m-0 text-base font-medium text-inherit">Tags</h3>
        <p class="sr-only">Browse articles by topic.</p>
      </div>
    </a>
    <a
      data-cursor="link"
      href="/blog/archive"
      class="plain-link group inline-flex items-center gap-2"
    >
      <div class="shrink-0">
        <Icon name="lucide:archive" class="h-4 w-4" />
      </div>
      <div>
        <h3 class="m-0 text-base font-medium text-inherit">Archives</h3>
        <p class="sr-only">Browse articles by timestamp.</p>
      </div>
    </a>
  </section>
  {
    page.data.length > 0 ? (
      <div class="post-list">
        {page.data.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    ) : (
      <section>
        <p class="text-sm text-gray-500 dark:text-gray-400">
          No blog posts yet. Add a Markdown file in{" "}
          <code class="rounded bg-gray-100 px-1.5 py-0.5 text-sm text-blue-600 dark:bg-gray-800 dark:text-blue-400">
            src/content/blog/
          </code>{" "}
          to begin.
        </p>
      </section>
    )
  }
  <nav
    aria-label="Blog pagination"
    class="blog-pagination mt-12 flex flex-wrap items-center justify-center gap-2 text-sm"
  >
    {
      page.url.prev ? (
        <a
          data-cursor="link"
          href={page.url.prev}
          data-tooltip="Previous page"
          aria-label="Previous page"
          class="pagination-link"
        >
          <Icon name="lucide:chevron-left" class="h-4 w-4" />
        </a>
      ) : (
        <span
          data-tooltip="No previous page"
          class="pagination-disabled"
          aria-disabled="true"
          aria-label="Previous page"
        >
          <Icon name="lucide:chevron-left" class="h-4 w-4" />
        </span>
      )
    }
    <div class="flex flex-wrap justify-center gap-2">
      {
        pageLinks.map((pageNumber) => {
          const href = pageNumber === 1 ? "/blog" : `/blog/${pageNumber}`;
          const isCurrent = page.currentPage === pageNumber;

          return (
            <a
              data-cursor="link"
              href={href}
              aria-current={isCurrent ? "page" : undefined}
              aria-label={`Page ${pageNumber}`}
              class="pagination-link"
            >
              {pageNumber}
            </a>
          );
        })
      }
    </div>
    {
      page.url.next ? (
        <a
          data-cursor="link"
          href={page.url.next}
          data-tooltip="Next page"
          aria-label="Next page"
          class="pagination-link"
        >
          <Icon name="lucide:chevron-right" class="h-4 w-4" />
        </a>
      ) : (
        <span
          data-tooltip="No next page"
          aria-label="Next page"
          class="pagination-disabled"
          aria-disabled="true"
        >
          <Icon name="lucide:chevron-right" class="h-4 w-4" />
        </span>
      )
    }
  </nav>
</BaseLayout>
