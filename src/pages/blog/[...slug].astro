---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import { getTagHref } from "../../utils/tags";
import { formatDate, formatISODate, getBlogPosts } from "../../utils/content";

export async function getStaticPaths() {
  const posts = await getBlogPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}

const post = Astro.props;
const { Content } = await render(post);
---

<BaseLayout
  pageTitle={post.data.title}
  description={post.data.description}
  readingProgress={true}
  readingLayout
>
  <div slot="page-header-details">
    <time
      datetime={formatISODate(post.data.pubDate)}
      class="inline-flex items-center gap-1 text-sm text-gray-600 dark:text-gray-400"
    >
      <Icon
        name="lucide:calendar"
        aria-hidden="true"
        class="mr-1 h-3.5 w-3.5 shrink-0"
      />
      <span>{formatDate(post.data.pubDate)}</span>
    </time>
    {
      post.data.tags.length > 0 && (
        <ul
          class="mt-3 flex flex-wrap gap-x-4 gap-y-2"
          aria-label="Article tags"
        >
          {post.data.tags.map((tag: string) => (
            <li>
              <a
                href={getTagHref(tag)}
                class="text-link inline-flex items-center gap-1 text-sm"
              >
                <Icon
                  name="lucide:tag"
                  aria-hidden="true"
                  class="mr-1 h-3.5 w-3.5 shrink-0"
                />
                <span>{tag}</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
  <article class="markdown-content">
    <Content />
  </article>
</BaseLayout>
