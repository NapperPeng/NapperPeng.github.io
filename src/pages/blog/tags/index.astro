---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getTagHref, getTagSummaries } from "../../../utils/tags";
import { getBlogPosts } from "../../../utils/content";
const tags = getTagSummaries(await getBlogPosts());
---

<BaseLayout pageTitle="Tags" description="Browse articles by topic.">
  {
    tags.length > 0 ? (
      <ul class="flex flex-wrap gap-x-8 gap-y-5">
        {tags.map((tag) => (
          <li>
            <a
              href={getTagHref(tag.name)}
              class="text-link inline-flex items-baseline gap-2"
            >
              <span>{tag.name}</span>
              <span class="text-xs text-gray-600 dark:text-gray-400">
                {tag.count}
              </span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <section>
        <p class="text-sm text-gray-500 dark:text-gray-400">
          No tags have been added yet.
        </p>
      </section>
    )
  }
</BaseLayout>
